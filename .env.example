# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gitforlaw123

# OpenAI API (for mutation parsing)
OPENAI_API_KEY=your-api-key-here

# Local LLM (for RAG - optional)
LOCAL_LLM_ENDPOINT=http://localhost:8000/v1

# Nyaya Ledger serving layer
NYAYA_CORPUS_DIR=corpus
NYAYA_SEARCH_INDEX=derived/search/corpus_search.jsonl
NYAYA_GRAPH_JSON=derived/graph/corpus_graph.json
NYAYA_LANCEDB_PATH=derived/vector/lancedb
NYAYA_LANCEDB_TABLE=nyaya_ledger_nomic_v1_5
NYAYA_EMBEDDING_ENDPOINT=http://127.0.0.1:1234/v1
NYAYA_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# FalkorDB graph serving index
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=nyaya_ledger
# Set to 1 to force JSON graph fallback without connecting to FalkorDB.
NYAYA_DISABLE_FALKORDB=0

# API/MCP bind settings
NYAYA_API_HOST=127.0.0.1
NYAYA_API_PORT=8080
NYAYA_MCP_TRANSPORT=stdio
NYAYA_MCP_HOST=127.0.0.1
NYAYA_MCP_PORT=8090
